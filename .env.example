# ---------------------------------------------------------------------------
# MY IPTV PRO — environment
# Copy to .env and edit. Everything here is optional except UPSTREAM_BASE
# (unless your channels.m3u already contains absolute https URLs).
# ---------------------------------------------------------------------------

PORT=3000
# Public origin the relay should advertise in manifests (behind a reverse proxy).
# Leave empty to derive it from the request Host / X-Forwarded-* headers.
# PUBLIC_URL=https://tv.example.com

# Your JioTV-Go style upstream. The relay ALWAYS calls <UPSTREAM_BASE>/live/high/<id>.m3u8
UPSTREAM_BASE=http://127.0.0.1:8081
UPSTREAM_HIGH_PATH=/live/high/{id}.m3u8
UPSTREAM_AUTO_PATH=/live/{id}.m3u8
# Emergency fallback only, when the high endpoint fails.
ALLOW_AUTO_FALLBACK=true
# UPSTREAM_UA=okhttp/4.9.3
# Extra headers for every upstream request:
# UPSTREAM_HEADERS={"referer":"https://example.com/","origin":"https://example.com"}

# Channel list (high://<id>, absolute URLs, or a provider M3U you imported).
CHANNELS_FILE=channels.m3u
WATCH_CHANNELS=true

# Channel list pulled straight from your own JioTV-Go server (recommended).
# Takes precedence over CHANNELS_FILE, which stays as the offline fallback.
CHANNELS_URL=https://tv.home.mangalvedhe.in/playlist.m3u?q=high
# Re-sync the list periodically (0 = at boot only, or POST /api/sync).
CHANNELS_REFRESH_MS=0
# Last good playlist; served when the server is unreachable (empty disables).
CHANNELS_CACHE_FILE=channels.cache.m3u

# Ready-to-use M3U file for VLC / TiviMate / OTT Navigator. It is regenerated
# automatically (empty = disable). 0 = write once at startup and after a sync.
# Must be writable by the process: inside the image /app is read-only for the
# `node` user, so Docker deployments use /app/.cache/playlist.m3u (a volume).
# If the path is not writable the relay falls back to <app>/.cache, then /tmp,
# warns once, and /api/status shows the real path in playlist.file.
PLAYLIST_FILE=channels.generated.m3u
PLAYLIST_REFRESH_MS=60000

# Keep only these channel languages (comma separated, ISO codes work too).
# Leave empty to keep every language.
CHANNEL_LANGUAGES=Bengali,Bangla,English,Hindi
# Let /api/probe check any URL (default: only the configured source).
# PROBE_ALLOW_ANY_URL=false
CHANNELS_URL_TIMEOUT_MS=8000
# CHANNELS_URL_HEADERS={"authorization":"Bearer …"}
# Promote playlist URLs like /live/<id>.m3u8 to /live/high/<id>.m3u8 and keep
# the original as the emergency fallback. low/medium are never used.
HIGH_FIRST_CUSTOM_URLS=true
# JioTV-Go lists DRM channels as /live/mpd/<id>?q=high (DASH/Widevine).
# Map them to /live/high/<id>.m3u8; set SKIP_DASH=true to hide them instead.
DASH_TO_HLS=true
SKIP_DASH=false

# Token provider (optional). Called per channel, cached for TOKEN_TTL_MS.
# {id} and {name} placeholders are substituted.
# TOKEN_URL=https://auth.example.com/token?channel={id}
# TOKEN_FIELD=token
# TOKEN_HEADER=Authorization
# TOKEN_HEADER_FORMAT=Bearer {token}
# TOKEN_QUERY=token
# TOKEN_TTL_MS=300000
# TOKEN_APPEND_SEGMENTS=false

# Warmer / cache
WARMER_ENABLED=true
WARMER_INTERVAL_MS=2000
WARMER_CONCURRENCY=24
CACHE_TTL_MS=2500
STALE_SERVE_MS=15000
HOT_WARM_MS=60000
MEDIA_CACHE_TTL_MS=1200
UPSTREAM_TIMEOUT_MS=1500

# Segments: redirect (default, 0 Mbps through the relay) | direct | proxy
SEGMENT_MODE=redirect

# Shared secret used to sign /s and /k URLs (set it for multi-instance deploys).
# URL_SECRET=change-me-please

LOG_LEVEL=info
# LOG_FORMAT=json
